# Copy to .env and fill in. .env is gitignored and never committed.
# Every value here has a working default except the optional external API key.

# --- ClickHouse (hot store) ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=otel
# Chapter 8: the reader that may query only the restricted database
# (otel_restricted), where flagged traces are copied in full.
CLICKHOUSE_RESTRICTED_PASSWORD=change-me
# Chapter 10: the read-only user Perses queries ClickHouse as (SELECT on otel.*
# and otel_restricted.*, nothing else).
CLICKHOUSE_PERSES_PASSWORD=change-me

# --- Model routing -----------------------------------------------------------
# All model calls go through the LiteLLM proxy. The committed default is a
# local, self-hosted Ollama endpoint: this repo does not require any hosted
# service to run. Point OLLAMA_BASE_URL at wherever you run Ollama.
OLLAMA_BASE_URL=http://ollama.agent-obs-platform.svc.cluster.local:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional external route. Leave OPENROUTER_API_KEY empty and LiteLLM simply
# will not expose the remote models. Setting it adds an external route
# alongside the local one — it does not replace it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Which route the workflow asks for by default: "local" or "remote".
DEFAULT_MODEL_ROUTE=local
# CPU inference speed is a property of the machine. One model call may take
# MODEL_TIMEOUT seconds and one triage run TRIAGE_TIMEOUT seconds before the
# client, or `make workflow-triage`, gives up. 300/900 fit 16-core workers; a
# 3B model writing to its token cap on a 12-vCPU VM needed 900/1800.
MODEL_TIMEOUT=300
TRIAGE_TIMEOUT=900

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=sk-change-me

# Encrypts provider credentials at rest in LiteLLM's database. Defaults to
# LITELLM_MASTER_KEY if unset, which couples key rotation to data readability —
# rotate the master key and stored credentials stop decrypting. Keep separate.
LITELLM_SALT_KEY=sk-salt-change-me

# LiteLLM admin UI login. Without these the UI accepts `admin` plus the master
# key, i.e. the full-API credential doubles as a browser password.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# --- Tool authorization (guide chapter 7) -----------------------------------
# Bearer tokens the workflow presents to the MCP tool servers, one per role.
# The servers map token -> role and check the role against
# deploy/80-mcp/policy.json. A reader may call the read-only tools; an
# operator may also restart a deployment. Any value; keep them distinct.
TOOL_TOKEN_READER=change-me-reader
TOOL_TOKEN_OPERATOR=change-me-operator

# --- Where this runs (lab-specific; docs/lab-environment.md) -----------------
# Nothing about a particular hypervisor, registry or cluster is baked into the
# Makefile or the scripts: it all comes from here. Two shapes are supported.
#   Single VM:  `make cluster` builds a one-node k3s on the Proxmox host below
#               and installs the Gateway, CloudNativePG and Prometheus it needs.
#   Existing:   point KUBECONFIG, REGISTRY, GATEWAY_IP and K8S_API_IP at a cluster
#               that already has those (deploy/01-cluster/README.md lists them).

# The Proxmox host both VMs are built on: an ssh alias or address, as root.
PVE_HOST=pve
# A cloud-init template to clone (Ubuntu 24.04 or Debian 13 cloud image, with
# qemu-guest-agent) and the storage pool to clone it onto. The installers add
# what the image lacks (xfsprogs, curl).
PVE_TEMPLATE_VMID=9000
PVE_STORAGE=local-lvm
# Network and login shared by the VMs; MINIO_VM_* / K3S_VM_* override per VM.
VM_GW=10.1.1.1
VM_DNS=10.1.1.1
VM_USER=ubuntu
VM_SSHKEY=~/.ssh/id_rsa.pub

# The registry the nodes pull from and the build host pushes to. Plain HTTP:
# the k3s installer tells containerd so, and the Docker host named below must
# list it under "insecure-registries" in its daemon.json.
REGISTRY=10.1.1.240:5000
# An amd64 Docker host, as a Docker context (`docker context ls`). Images are
# built there, never on the workstation (arm64).
DOCKER_BUILD_CONTEXT=pve

# --- The cluster (make k3s-vm) ----------------------------------------------
K3S_VMID=1041
K3S_VM_NAME=agent-obs-k3s
K3S_VM_IP=10.1.1.21
K3S_VM_CORES=12
K3S_VM_MEMORY=32768
K3S_VM_DISK_GB=160
K3S_VERSION=v1.36.5+k3s1
# Where `make k3s-vm` writes the kubeconfig, and what every kubectl and helm
# call in the Makefile then uses. Relative to the repository root; gitignored.
# Leave empty to use your default kubeconfig (an existing cluster).
KUBECONFIG=./kubeconfig-agent-obs
# The address the `platform` Gateway answers on for *.kube.local. On a single
# node this is the VM itself (k3s ServiceLB); on the original lab, a MetalLB
# address. `make cluster-prereqs` warns if the Gateway disagrees.
GATEWAY_IP=10.1.1.21
# The control-plane node, as seen from a pod after NAT: where mcp-ops reaches
# the API server (chapter 7's NetworkPolicy). Defaults to K3S_VM_IP.
K8S_API_IP=10.1.1.21

# --- MinIO (object storage, standalone VM on the Proxmox host) ----------------
# MinIO runs OUTSIDE Kubernetes on purpose: it is meant to be the durable thing
# the cluster leans on, and a store scheduled by the cluster it backs cannot
# serve that role. `make minio-vm` builds the VM from these values on PVE_HOST.
MINIO_VMID=1040
MINIO_VM_IP=10.1.1.20
MINIO_VM_DATA_GB=500
MINIO_ENDPOINT=http://10.1.1.20:9000

# Root credential. Used only to build the VM and mint the scoped key below;
# it is never published into Kubernetes.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# What the cluster actually gets: a separate MinIO user whose policy covers
# MINIO_BUCKETS and nothing else, so a leaked in-cluster Secret cannot read the
# backups of the thing that leaked it.
MINIO_K8S_ACCESS_KEY=k8s
MINIO_K8S_SECRET_KEY=change-me
MINIO_BUCKETS="otel-archive clickhouse-cold cnpg-backups workflow-artifacts"
