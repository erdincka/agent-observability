# Copy to .env and fill in. .env is gitignored and never committed.
# Every value here has a working default except the optional external API key.

# --- ClickHouse (hot store) ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=otel

# --- Model routing -----------------------------------------------------------
# All model calls go through the LiteLLM proxy. The committed default is a
# local, self-hosted Ollama endpoint: this repo does not require any hosted
# service to run. Point OLLAMA_BASE_URL at wherever you run Ollama.
OLLAMA_BASE_URL=http://ollama.agent-obs-platform.svc.cluster.local:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional external route. Leave OPENROUTER_API_KEY empty and LiteLLM simply
# will not expose the remote models. Setting it adds an external route
# alongside the local one — it does not replace it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Which route the workflow asks for by default: "local" or "remote".
DEFAULT_MODEL_ROUTE=local

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=sk-change-me
