# Copy to .env and fill in. .env is gitignored and never committed.
# Every value here has a working default except the optional external API key.

# --- ClickHouse (hot store) ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=otel
# Chapter 8: the reader that may query only the restricted database
# (otel_restricted), where flagged traces are copied in full.
CLICKHOUSE_RESTRICTED_PASSWORD=change-me
# Chapter 10: the read-only user Perses queries ClickHouse as (SELECT on otel.*
# and otel_restricted.*, nothing else).
CLICKHOUSE_PERSES_PASSWORD=change-me

# --- Model routing -----------------------------------------------------------
# All model calls go through the LiteLLM proxy. The committed default is a
# local, self-hosted Ollama endpoint: this repo does not require any hosted
# service to run. Point OLLAMA_BASE_URL at wherever you run Ollama.
OLLAMA_BASE_URL=http://ollama.agent-obs-platform.svc.cluster.local:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional external route. Leave OPENROUTER_API_KEY empty and LiteLLM simply
# will not expose the remote models. Setting it adds an external route
# alongside the local one — it does not replace it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Which route the workflow asks for by default: "local" or "remote".
DEFAULT_MODEL_ROUTE=local

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=sk-change-me

# Encrypts provider credentials at rest in LiteLLM's database. Defaults to
# LITELLM_MASTER_KEY if unset, which couples key rotation to data readability —
# rotate the master key and stored credentials stop decrypting. Keep separate.
LITELLM_SALT_KEY=sk-salt-change-me

# LiteLLM admin UI login. Without these the UI accepts `admin` plus the master
# key, i.e. the full-API credential doubles as a browser password.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# --- Tool authorization (guide chapter 7) -----------------------------------
# Bearer tokens the workflow presents to the MCP tool servers, one per role.
# The servers map token -> role and check the role against
# deploy/80-mcp/policy.json. A reader may call the read-only tools; an
# operator may also restart a deployment. Any value; keep them distinct.
TOOL_TOKEN_READER=change-me-reader
TOOL_TOKEN_OPERATOR=change-me-operator

# --- MinIO (object storage, standalone VM on the Proxmox host) ----------------
# MinIO runs OUTSIDE Kubernetes on purpose: it is meant to be the durable thing
# the cluster leans on, and a store scheduled by the cluster it backs cannot
# serve that role. `make minio-vm` builds the VM from these values.
PVE_HOST=pve
MINIO_VMID=1040
MINIO_VM_IP=10.1.1.20
MINIO_VM_DATA_GB=500
MINIO_ENDPOINT=http://10.1.1.20:9000

# Root credential. Used only to build the VM and mint the scoped key below;
# it is never published into Kubernetes.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# What the cluster actually gets: a separate MinIO user whose policy covers
# MINIO_BUCKETS and nothing else, so a leaked in-cluster Secret cannot read the
# backups of the thing that leaked it.
MINIO_K8S_ACCESS_KEY=k8s
MINIO_K8S_SECRET_KEY=change-me
MINIO_BUCKETS="otel-archive clickhouse-cold cnpg-backups workflow-artifacts"
