# Python
__pycache__/
*.py[cod]
.venv/
venv/
# Local convenience only — the build resolves from pyproject.toml, so a lock
# file here locks nothing that ships. Testing and deployment go through the image.
uv.lock
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
.next/
dist/

# Secrets — never commit rendered values
.env
*.env
.env.*
!.env.example
secrets/
*-secret.yaml
!*-secret.example.yaml
kubeconfig*
*.pem
*.key

# Local tooling
.DS_Store
.idea/
.vscode/
*.log

# Helm
charts/**/charts/
*.tgz
config.rendered.yaml
